# ===================================================
# SIDERPERU - Variables de Entorno (Vercel / Local)
# ===================================================

# 1. Configuración de Correo Emisor SMTP (Recomendado: Gmail / Outlook)
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_o_clave_de_aplicacion
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# 2. Correo y Nombre del Remitente Visible
SIDER_SENDER_EMAIL=notificaciones@siderperu.com.pe
SIDER_SENDER_NAME=SIDERPERU - Sistema de Notificaciones SAP

# 3. Correo del Administrador para Recibir Solicitudes
SIDER_ADMIN_EMAIL=almacen.central@siderperu.com.pe

# 4. (Opcional) Resend API Key si prefieres usar Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
