{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/operario", "destination": "/index.html" },
    { "source": "/api/usuarios", "destination": "/usuarios_sider.json" },
    { "source": "/api/send-email", "destination": "/api/send-email.js" },
    { "source": "/api/solicitudes", "destination": "/api/solicitudes.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
